{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts", "../src/lib/validation.ts", "../src/lib/content.ts", "../src/content/defaultSite.ts"]
}
