# Copiá este archivo a .env. En producción estas variables las carga el hosting.

# Cadena de MongoDB Atlas. Sin este valor, el desarrollo usa una base temporal que se borra al apagar el proceso.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/casamiento

# Secreto de la sesión del panel. Al menos 16 caracteres. En producción es obligatorio.
JWT_SECRET=cambiala-por-una-frase-larga

# Ingreso del panel. Al arrancar se sincroniza con estos valores; el login usa ADMIN_PASSWORD.
ADMIN_EMAIL=novios@florenciaeignacio.local
ADMIN_PASSWORD=cambiar-esta-clave

# Origen del front cuando no lo sirve Express (p. ej. otro dominio). En producción, vacío = solo misma origen (sin CORS abierto).
CLIENT_ORIGIN=

# Puerto del proceso que queda prendido.
PORT=4000
